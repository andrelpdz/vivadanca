INSERT INTO `linha_tempo` (`id`, `foto`, `descricao`, `data`) VALUES
(13, 'Vivadanca8.jpg', 'Foi quando o grupo começou, O grupo inicial reunia mulheres com trajetórias diversas: algumas vinham de experiências em bailes, teatro, música, desfiles; outras nunca haviam dançado, movidas apenas pela vontade de aprender.', 2015),
(14, 'Vivadanca3.jpg', 'Diante da possibilidade de não poderem continuar juntas na formação ligada ao JORI, Suely propõe: “Vamos montar o nosso grupo”. A decisão é tomada: criam o Viva Dança Sorocaba, com Vítor Gil como coreógrafo. Sem apoio institucional, organizam bingos, rifas, festas e campanhas para custear ensaios no Central Parque, figurinos e viagens. A coreografia Lancem as Cartas marca essa fase.', 2017),
(15, 'Vivadanca1.jpg', 'O grupo amplia a circulação: festivais em cidades paulistas e em Piratuba (SC), que se torna um espaço querido e simbólico. Ingressam no Festival de Dança de Joinville sempre que há categoria para 60+. O repertório cresce: dança indiana, Bollywood, sapateado, dança italiana e salsa. A Hora do Show é apontada como uma das primeiras coreografias de sapateado do grupo.', 2018),
(16, 'Vivadanca9.jpg', 'Conquistam a medalha de ouro na etapa estadual dos Jogos da Melhor Idade em Jundiaí, com dança indiana — considerada título inédito para Sorocaba. Participam de programa de televisão com Faustão, apresentando Indiana e Sapatear Bollywood. O reconhecimento confirma que artistas 60+ brilham em palcos competitivos.', 2019),
(17, 'Vivadanca2.jpg', 'Ensaios e apresentações são interrompidos pela pandemia. Neide conhece o grupo em apresentação no Teatro Municipal de Sorocaba e decide participar, ingressando neste período. Enfrentam o desafio de recomeçar, mantendo viva a convivência e o desejo de dançar.', 2020),
(18, 'Vivadanca7.jpg', 'Retomam os palcos com premiações em Sorocaba, Pindamonhangaba, Itu, Vinhedo, Mauá, Barra Bonita, Indaiatuba e Curitiba. Fábio (primeiro homem do elenco) e Eliana ingressam — ela estreia aprendendo uma coreografia de sapateado em apenas duas semanas, com conquista de 1º lugar em Curitiba. O grupo passa a ensaiar no Centro do Professorado Paulista (CPP).', 2021),
(19, 'Vivadanca4.jpg', 'Viagem artística a Portugal: duas apresentações, dois segundos lugares e recebimento de certificado-convite para apresentações internacionais. Parte das integrantes estende a viagem pela Europa. Nasce Memórias em Trânsito, obra contemporânea com malas e deslocamentos, celebrando a experiência de vida sem reduzir-se à idade.', 2024),
(20, 'Vivadanca6.jpg', 'Em julho de 2025, Cristina ingressa no grupo, retomando o sapateado de forma autônoma. Em janeiro de 2026, faz sua estreia oficial. O elenco atual reúne 10 artistas 60+ (9 mulheres + 1 homem) e o coreógrafo: fundadoras, integrantes antigas e recém-chegadas, unindo memória e renovação. Três novas coreografias estão em preparação.', 2026),
(21, 'Vivadanca5.jpg', 'Lançamento da Matriz Institucional consolidada. Mais de 10 anos de trajetória, 99 registros de atividades, 41 premiações, 54 troféus e reconhecimentos. O futuro traz metas: formar turma preparatória, digitalizar o acervo, produzir documentário/livro/exposição, ampliar a circulação e captar recursos para garantir que a dança continue sendo direito de todos.', 2026);

